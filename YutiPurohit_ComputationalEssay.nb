Cell["\<\
The Lennard-Jones potential equation is defined with parameters eps \
representing the Lennard-Jones depth and sigma representing the size proxy.\
\>", "Text",
 CellChangeTimes->{{3.96101492829027*^9, 
  3.961014959298106*^9}},ExpressionUUID->"d40f22ab-6d60-5d43-9fc7-\
0163a33bcf26"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LJ", "[", 
    RowBox[{"r_", ",", "eps_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{"4", "*", "eps", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"sigma", "/", "r"}], ")"}], "^", "12"}], ")"}], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"sigma", "/", "r"}], ")"}], "^", "6"}], ")"}]}], ")"}]}]}], 
  "\n"}]], "Input",
 CellChangeTimes->{
  3.9609722716911793`*^9, {3.960993003660968*^9, 3.960993011031467*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"3441e871-3cf6-ac4e-9740-35898ad60934"],

Cell["\<\
The potential energy data is stripped of units to ensure it can be directly \
fit to the Lennard-Jones equation.\
\>", "Text",
 CellChangeTimes->{{3.961014969637672*^9, 
  3.9610150035898533`*^9}},ExpressionUUID->"3abe5282-f203-2447-950d-\
59d0595a11ed"],

