Cell["\<\
A NonlinearModelFit is implemented to fit the potential energy equation to \
the Lennard Jones potential. This fit willh elp determine the Lennard-Jones \
depth and the size-proxy.\
\>", "CodeText",
 CellChangeTimes->{{3.961148300303596*^9, 
  3.9611483495970087`*^9}},ExpressionUUID->"39302c08-e988-d443-ada6-\
78e50248ac18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fit", " ", "=", " ", 
  RowBox[{"Quiet", "[", 
   RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
    RowBox[{"plainSurf", ",", "\[IndentingNewLine]", 
     RowBox[{"LJ", "[", 
      RowBox[{"r", ",", "eps", ",", "sigma"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eps", ",", " ", "0.01"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"sigma", ",", " ", "3"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "r"}], "\[IndentingNewLine]", "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.960975330985444*^9, 3.96097536276616*^9}, {
