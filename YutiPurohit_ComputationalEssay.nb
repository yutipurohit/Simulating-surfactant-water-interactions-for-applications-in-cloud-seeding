Cell["\<\
The CTAB-water size-proxy and LJ depth are computed using the combination \
rules.\
\>", "CodeText",
 CellChangeTimes->{{3.961158774194457*^9, 
  3.9611588037333117`*^9}},ExpressionUUID->"fce030a0-ab13-774e-9bec-\
6dc245883c7d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigmaCombined", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"sigmaN4", " ", "+", " ", "sigmaOW"}], ")"}], "/", "2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"epsilonCombined", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"epsilonN4", "*", "epsilonOW"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.961028816493082*^9, {3.9611117193309107`*^9, 3.961111720298539*^9}, {
   3.9611619212419024`*^9, 3.961161948215702*^9}},
 CellLabel->
  "In[1076]:=",ExpressionUUID->"f2981fe4-468f-0a4a-99b5-4c25edf92a13"],

Cell["\[LineSeparator]Now, the Lennard-Jones potential can be graphed:", \
"Text",
 CellChangeTimes->{{3.960300419011631*^9, 3.9603004230779114`*^9}, {
  3.960300697304867*^9, 3.9603007297114944`*^9}, {3.96036493523999*^9, 
  3.9603649469282494`*^9}, {3.9610301215944853`*^9, 
  3.961030129875195*^9}},ExpressionUUID->"5274afc6-2c9f-3c49-9185-\
995a56abd743"],

Cell["\<\
The general movement of the droplet is defined by lennardJones, and in the \
case of interactions with surfactants, it models the Lennard-Jones Potential:\
\>", "CodeText",
 CellChangeTimes->{{3.9610167766191263`*^9, 3.961016791880889*^9}, {
  3.961158813780301*^9, 3.9611588149644613`*^9}, {3.9611589301384*^9, 
  3.9611589670639553`*^9}, {3.961159199578182*^9, 
  3.961159201674395*^9}},ExpressionUUID->"f1f2ef7f-97ec-434c-8cdd-\
edbebdd53f85"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lennardJones", "[", "r_", "]"}], ":=", 
   RowBox[{"4", "*", "epsilonCombined", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"sigmaCombined", "/", "r"}], ")"}], "^", "12"}], ")"}], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"sigmaCombined", "/", "r"}], ")"}], "^", "6"}], ")"}]}], 
     ")"}]}]}], "\n"}]], "Input",
 CellChangeTimes->{
  3.960300426376257*^9, 3.9603004855003967`*^9, 3.9603005177512054`*^9, {
   3.960300787166836*^9, 3.9603007899170094`*^9}, {3.9603009237686253`*^9, 
   3.960300926774458*^9}, {3.960300961962208*^9, 3.9603009770929985`*^9}, {
   3.961016805933756*^9, 3.961016808672748*^9}, 3.961159214861927*^9, {
   3.961161960933675*^9, 3.96116199686695*^9}, {3.961162115869363*^9, 
   3.961162116842843*^9}, {3.9611622863158627`*^9, 3.961162294190197*^9}},
 CellLabel->
  "In[951]:=",ExpressionUUID->"be2e9e32-d351-024e-a8c4-7d3ec8b9bb59"],

Cell["\<\
The minimum value of the function lennardJones is calculated and recorded, as \
well as the distance that evaluates to this minimum.\
\>", "CodeText",
 CellChangeTimes->{{3.9610168297806807`*^9, 3.961016852572914*^9}, 
   3.961159219698842*^9},ExpressionUUID->"2257b4d9-63a2-014e-a5c0-\
f86290238b6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NMinimize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"lennardJones", "[", "r", "]"}], ",", 
     RowBox[{"0.2", "<=", "r", "<=", "1.0"}]}], "}"}], ",", "r"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.961016813100453*^9, 3.961016816470097*^9}, 
   3.9611592315675497`*^9},
 CellLabel->
  "In[952]:=",ExpressionUUID->"8b26d8a6-1d54-f042-8c40-82f6ecdaa8b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.6338955749963869`"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", "\[Rule]", "0.4105966174786523`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9608857700648804`*^9, 3.96101705296524*^9, 3.961161784948792*^9, 
   3.9611618346991243`*^9, 3.961161911869155*^9, {3.961161983886739*^9, 
   3.961161999122855*^9}, 3.9611620628344097`*^9, 3.9611621194277554`*^9, 
   3.961162297182288*^9, 3.961162391295175*^9},
 CellLabel->
  "Out[952]=",ExpressionUUID->"1efe728b-b3c5-9d46-a710-3077b778c8bc"]
}, Open  ]],

Cell["\<\
The function Plot is used to display the Lennard-Jones potential as the \
distance between the molecules changes. \
\>", "CodeText",
 CellChangeTimes->{{3.961016869985943*^9, 
  3.9610169027727833`*^9}},ExpressionUUID->"917fa120-316a-4c4a-b30c-\
43d348ff50f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"lennardJones", "[", "r", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0.1", ",", "1.0"}], "}"}], ",", 
   RowBox[{"PlotRange", " ", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "2"}], ",", "7"}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", "\"\<LJ Potential between CTAB N\:207a and Water\>\""}],
    ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<r (nm)\>\"", ",", "\"\<V(r) (kJ/mol)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", 
   RowBox[{"PlotStyle", "->", "Thick"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.96101682103782*^9, 3.9610168603243856`*^9, {3.961016963181777*^9, 
   3.961017020857916*^9}, 3.9611592371033*^9},
