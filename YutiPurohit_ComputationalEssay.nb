Cell["\<\
The model to optimize the geometry is defined and run as HartreeFock at \
sto-3g. Though this model is very efficient, it is not as precise as more \
computationally-expensive as other models. \
\>", "CodeText",
 CellChangeTimes->{{3.960973238431823*^9, 3.9609733031417437`*^9}, {
   3.960976224105629*^9, 3.960976235662829*^9}, 
   3.961057469945772*^9},ExpressionUUID->"6d91ce47-0f43-8744-a106-\
c298ea88a923"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"optimizationHF", " ", "=", " ", 
  RowBox[{"ModelChemistry", "[", 
   RowBox[{"\"\<HartreeFock\>\"", ",", " ", "\"\<sto-3g\>\""}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.960904078113303*^9, 3.9609040902927847`*^9}, {
  3.96116389328528*^9, 3.961163907425736*^9}},
