Cell["\<\
A molecule of CTAB, referred to as mol, is created, and its electrical energy \
is accessed via GroundStateEnergy. The molecule geometry is a guess and not \
usually the true lowest-energy shape.\
\>", "Text",
 CellChangeTimes->{{3.960914967998698*^9, 3.960915020779036*^9}, {
  3.9609154299248962`*^9, 3.9609154652493753`*^9}, {3.960971413044375*^9, 
  3.9609714312160463`*^9}, {3.961170199340741*^9, 
  3.961170208054742*^9}},ExpressionUUID->"dbe80d61-a0ac-b142-89b7-\
8ebec1812907"],

Cell["\<\
It is impossible to analytically solve Schrodinger\[CloseCurlyQuote]s \
equations with multiple electrons due to it being impossible to compute \
electron-electron interactions and to describe all the electrons in a \
molecule at once. Thus,  ModelChemistry must be utilized and loaded.\
\>", "Text",
 CellChangeTimes->{{3.960915213854949*^9, 3.960915331798381*^9}, 
   3.960915485546701*^9, {3.960915567228582*^9, 3.960915573912489*^9}, {
   3.960915642104562*^9, 3.96091564243264*^9}, {3.960916050096436*^9, 
   3.960916055063492*^9}, {3.960971149771995*^9, 3.960971183436057*^9}, {
   3.961170212392448*^9, 
   3.961170212693158*^9}},ExpressionUUID->"91ea13f4-9167-ba40-9f8b-\
03c1ceed7f00"],

Cell["ModelChemistry is loaded.", "CodeText",
 CellChangeTimes->{{3.961057399255528*^9, 
  3.961057403106142*^9}},ExpressionUUID->"c62448fc-62ca-f74a-a7ab-\
2638206e1c6e"],

