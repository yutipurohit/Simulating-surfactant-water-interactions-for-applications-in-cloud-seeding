Cell["\<\
The raw values of the data is saved to plainSurf, and the LJ equation is \
redefined.\
\>", "CodeText",
 CellChangeTimes->{{3.961148256630831*^9, 
  3.961148272726965*^9}},ExpressionUUID->"f2ceeca3-f090-034f-a02d-\
03368d5d8803"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"plainSurf", " ", "=", " ", 
  RowBox[{"QuantityMagnitude", "[", "optimizedSurf", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LJ", "[", 
   RowBox[{"r_", ",", "eps_", ",", "sigma_"}], "]"}], ":=", 
  RowBox[{"4", "*", "eps", "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"sigma", "/", "r"}], ")"}], "^", "12"}], ")"}], "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"sigma", "/", "r"}], ")"}], "^", "6"}], ")"}]}], 
    ")"}]}]}], "\n"}], "Input",
