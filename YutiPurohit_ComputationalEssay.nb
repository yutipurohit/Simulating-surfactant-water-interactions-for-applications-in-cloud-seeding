Cell[TextData[{
 "This graph aligns with expected results as it resembles a Morse Potential \
Energy curve.\n\nGiven this model of the LJ potential between CTAB and the \
water molecule, the force must be determined. \nAs is known:\nF(r) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["dV", "dr"]}], TraditionalForm]],ExpressionUUID->
  "f42417f1-5b7f-0d43-a40b-8c144dc9254b"],
 "\n\nThus, by taking the negative derivative of the potential, the total \
force can be calculated."
}], "Text",
 CellChangeTimes->{{3.960365100638077*^9, 3.9603651791840553`*^9}, {
  3.960365215639307*^9, 3.960365363696682*^9}, {3.961017061267126*^9, 
  3.961017073559153*^9}, {3.961017166931225*^9, 3.961017184504138*^9}, {
  3.961030152070496*^9, 3.961030192866468*^9}, {3.961158988549094*^9, 
  3.961159008620829*^9}},ExpressionUUID->"62f477d0-e7b2-b744-9d40-\
fc1cd0347853"],

Cell["The negative derivative is calculated:", "CodeText",
 CellChangeTimes->{{3.961017212515725*^9, 3.961017255953771*^9}, {
  3.96116214240676*^9, 
  3.961162149746037*^9}},ExpressionUUID->"2aef3fe6-8954-0747-9b92-\
85241333e385"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Vpure", "[", "r_", "]"}], "=", 
   RowBox[{"4", "*", "epislonProper", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"sigmaProper", "/", "r"}], ")"}], "^", "12"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"sigmaProper", "/", "r"}], ")"}], "^", "6"}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.961162605520773*^9},
 CellLabel->
  "In[979]:=",ExpressionUUID->"6b2402c8-9b09-4a49-bcf1-cd3d5d7d3be2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ljForce", "[", "r_", "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Vpure", "[", "r", "]"}], ",", "r"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9603653734516106`*^9, {3.960365673594572*^9, 3.9603656751515713`*^9}, {
   3.9603744929399433`*^9, 3.9603744985791817`*^9}, {3.9603745739961586`*^9, 
   3.960374620298828*^9}, {3.961017261259943*^9, 3.961017262620229*^9}, {
   3.961159259103862*^9, 3.961159262870926*^9}, {3.961162133505072*^9, 
   3.961162164238769*^9}, 3.961162610137907*^9},
 CellLabel->
  "In[980]:=",ExpressionUUID->"051e77a2-e00e-444a-9336-9cd90bda6eab"],

Cell["\<\
Now, because the force is radial, it must me split into x and y components.\
\>", "Text",
 CellChangeTimes->{{3.96036550304554*^9, 3.9603655137546844`*^9}, {
  3.9603655557975006`*^9, 3.9603655676240005`*^9}, {3.961030256382453*^9, 
  3.961030272638866*^9}},ExpressionUUID->"51fb887d-6b18-c14c-8062-\
bca317c3093c"],

Cell["\<\
By splitting the magnitude of the force along the Cartesian directions, the x \
and y components of the radial force are defined.\
\>", "CodeText",
 CellChangeTimes->{{3.961018358902938*^9, 
  3.961018400987612*^9}},ExpressionUUID->"0a54aa2f-97e6-234f-ba4d-\
6367e1efe43d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ljFx", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "f"}], "}"}], ",", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"f", "=", 
        RowBox[{"QuantityMagnitude", "[", 
         RowBox[{"ljForce", "[", "r", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"f", "*", 
        RowBox[{"x", "/", "r"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ljFy", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "f"}], "}"}], ",", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f", "=", 
       RowBox[{"QuantityMagnitude", "[", 
        RowBox[{"ljForce", "[", "r", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f", "*", 
       RowBox[{"y", "/", "r"}]}]}]}], "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9603655267340107`*^9, 3.9603655365813847`*^9}, 
   3.960374506579115*^9, {3.960374635318983*^9, 3.960374640021097*^9}, {
   3.960374727319151*^9, 3.9603747410229588`*^9}, 3.9607369001940117`*^9, 
   3.9607369765066776`*^9, {3.960893637184601*^9, 3.9608936380162373`*^9}, {
   3.961018259507862*^9, 3.9610182608745823`*^9}, {3.961159275619207*^9, 
   3.961159303197651*^9}},
 CellLabel->
  "In[981]:=",ExpressionUUID->"45d9f4c7-0b91-f947-8970-286777adcdd5"],

Cell["\<\
The initial positions are defined in terms of x and y, and the initial \
velocity is defined in terms of x and y components. Note that the position of \
the surfactant molecule is (0, 0).
\
\>", "CodeText",
 CellChangeTimes->{{3.961018431922702*^9, 3.9610184524509*^9}, {
  3.961020816632288*^9, 3.9610208249106216`*^9}, {3.961030793223116*^9, 
  3.961030817767961*^9}},ExpressionUUID->"e255a312-e086-1c45-be1c-\
fd7be4ab3820"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y0", "=", "0.5"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vx0", "=", 
   RowBox[{"-", "0.1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vy0", "=", 
   RowBox[{"-", "0.2"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9603655762038803`*^9, 3.9603655897508907`*^9}, {
  3.9603745183191853`*^9, 3.9603745204769745`*^9}, {3.960375172808544*^9, 
  3.960375173685795*^9}, {3.9603885234673862`*^9, 3.960388531337631*^9}, {
  3.960630012201376*^9, 3.9606300160151176`*^9}, {3.9606305227522087`*^9, 
  3.960630556320978*^9}},
 CellLabel->
  "In[983]:=",ExpressionUUID->"54c388d3-f311-e649-abc6-01c932f6dfc0"],

Cell["\<\
The NDSolve function numerically solves the system of second-order ODEs for x \
and y over time.\
\>", "CodeText",
 CellChangeTimes->{{3.960539140515028*^9, 3.960539140657831*^9}, {
   3.960539201278446*^9, 3.960539202923731*^9}, {3.960629576705303*^9, 
   3.96062958581287*^9}, 3.9606314716973553`*^9, {3.961019209874378*^9, 
   3.9610192270699053`*^9}},ExpressionUUID->"d2b97707-dc9d-bb46-9667-\
fc51e3f5c4d3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "''"}], "[", "t", "]"}], "==", 
        RowBox[{"ljFx", "[", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", 
          RowBox[{"y", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "''"}], "[", "t", "]"}], "==", 
        RowBox[{"ljFy", "[", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", 
          RowBox[{"y", "[", "t", "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "vx0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "0", "]"}], "==", "vy0"}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0.1", ",", "40"}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nsol", "=", 
   RowBox[{"First", "[", "sol", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.960365603011833*^9, 3.9603656450632286`*^9}, 
   3.9603745295087433`*^9, {3.9603747560076027`*^9, 3.9603747564441433`*^9}, {
   3.960374899177164*^9, 3.9603749378769608`*^9}, {3.9603751420030537`*^9, 
   3.960375155227495*^9}, {3.960629986029722*^9, 3.9606299864726524`*^9}, {
   3.96063078794306*^9, 3.9606307886813354`*^9}, 3.9606308289102*^9, {
   3.9610186845555887`*^9, 3.961018685227192*^9}, 3.961019221628459*^9, {
   3.961159323646462*^9, 3.961159326942811*^9}, {3.9611626559219627`*^9, 
   3.9611626564012012`*^9}},
 CellLabel->
  "In[1057]:=",ExpressionUUID->"36767d4c-8fae-5847-926f-089bb8317920"],

Cell["\<\
The different parametric plots, of x vs t and x vs t, are graphed  to see how \
the individual position components move over time using the ParametricPlot \
function. The range of t is set between 0 and 40 seconds because that is \
sufficient to see the interaction between the water molecule and CTAB.\
\>", "CodeText",
 CellChangeTimes->{{3.960631480034748*^9, 3.960631507034233*^9}, {
   3.9610207412256737`*^9, 3.9610207910255632`*^9}, 
   3.9611612273187513`*^9},ExpressionUUID->"cfbe502b-d3bd-6842-a566-\
e2702d385bc9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tmax", "=", "40"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"x", "[", "t", "]"}]}], "}"}], "/.", " ", "sol"}], "]"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0.1", ",", "tmax"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<t(ps)\>\"", ",", "\"\<x (nm)\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
    "PlotLabel", "->", "\"\<Trajectory under Lennard\[Dash]Jones Force\>\""}],
     ",", "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "->", "1"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "->", "Thick"}], ",", "\[IndentingNewLine]", 
    RowBox[{"GridLines", "->", "Automatic"}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"y", "[", "t", "]"}]}], "}"}], "/.", " ", "sol"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0.1", ",", "tmax"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t(ps)\>\"", ",", "\"\<y (nm)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
   "PlotLabel", "->", "\"\<Trajectory under Lennard\[Dash]Jones Force\>\""}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "->", "1"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "->", "Thick"}], ",", "\[IndentingNewLine]", 
   RowBox[{"GridLines", "->", "Automatic"}]}], "\[IndentingNewLine]", 
  "]"}], "\n"}], "Input",
 CellChangeTimes->{
  3.9603747923626003`*^9, {3.9603748327323494`*^9, 3.9603748345427303`*^9}, {
   3.9603748688901844`*^9, 3.96037489121805*^9}, {3.960375583227581*^9, 
   3.960375639669508*^9}, {3.9603885397277355`*^9, 3.9603885398785496`*^9}, {
   3.961162427527143*^9, 3.9611624311210318`*^9}, {3.961162690965354*^9, 
