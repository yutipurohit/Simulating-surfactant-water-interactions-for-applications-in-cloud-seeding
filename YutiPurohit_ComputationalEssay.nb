Cell["\<\
The MoleculeModify function is used to create a Zero Order bond between the \
Oxygen at index 34 and the Hydrogen in the water molecule. The hydrogen bond \
was treated as a zero order.\
\>", "CodeText",
 CellChangeTimes->{{3.961145646146991*^9, 
  3.9611457358175488`*^9}},ExpressionUUID->"33838916-3d58-754f-a31d-\
09ace5ad5dd3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MoleculeModify", "[", 
  RowBox[{"waterMoleculeComp", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<AddBond\>\"", ",", 
     RowBox[{"Bond", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"34", ",", "83"}], "}"}], ",", "\"\<ZeroOrder\>\""}], "]"}]}],
     "}"}]}], "]"}]], "Input",
